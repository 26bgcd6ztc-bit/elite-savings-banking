<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elite Solace Savings</title>
    <style>
        :root {
            --primary-blue: #1e40af;
            --accent-blue: #3b82f6;
            --pending-orange: #f59e0b;
            --success-green: #22c55e;
            --light-black: #1a1a1a;
            /* New colors for the image_10.png login style */
            --login-bg: #f8fafc;
            --text-gray: #64748b;
            --border-color: #e2e8f0;
        }

        body { font-family: 'Segoe UI', sans-serif; background-color: #000; margin: 0; display: flex; justify-content: center; }
        .phone-view { width: 100%; max-width: 414px; min-height: 100vh; background: var(--light-black); position: relative; display: flex; flex-direction: column; overflow: hidden; color: white; }
        .screen { display: none; padding: 20px; flex: 1; overflow-y: auto; box-sizing: border-box; padding-bottom: 110px; }
        .active { display: block; }

        /* --- UPDATED LOGIN INTERFACE PER image_10.png --- */
        #scr-login { background-color: var(--login-bg); color: #1e293b; padding: 0; }
        .login-container { display: flex; flex-direction: column; align-items: center; padding: 40px 20px; text-align: center; }
        
        .logo-header { color: #0047bb; font-weight: 800; font-size: 22px; display: flex; align-items: center; gap: 8px; margin-bottom: 40px; text-transform: uppercase; line-height: 1; }
        .logo-header b { font-size: 26px; border: 3px solid #0047bb; border-radius: 50%; width: 35px; height: 35px; display: inline-flex; align-items: center; justify-content: center; margin-right: 5px; }

        .login-card { background: white; width: 100%; border-radius: 20px; padding: 30px 25px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); box-sizing: border-box; }
        .login-card h2 { margin: 0 0 10px 0; font-size: 22px; color: #000; text-align: left; }
        .login-card p { font-size: 14px; color: var(--text-gray); margin-bottom: 25px; text-align: left; line-height: 1.4; }
        
        .input-group { margin-bottom: 18px; text-align: left; }
        .input-group label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #1e293b; }
        .input-wrapper { position: relative; display: flex; align-items: center; }
        .input-wrapper i { position: absolute; left: 15px; color: #94a3b8; font-style: normal; }
        
        .login-input { width: 100%; padding: 14px 14px 14px 45px !important; border: 1.5px solid var(--border-color) !important; border-radius: 10px !important; font-size: 15px !important; background: white !important; color: #000 !important; margin: 0 !important; }
        
        .forgot-link { float: right; color: #0047bb; text-decoration: none; font-size: 13px; font-weight: 600; }
        .checkbox-wrap { display: flex; align-items: center; gap: 10px; font-size: 13px; color: #1e293b; margin: 20px 0; text-align: left; }
        
        .btn-signin { width: 100%; background: #0047bb; color: white; padding: 16px; border: none; border-radius: 10px; font-weight: 700; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; }
        .btn-enroll { width: 100%; background: #f1f5f9; color: #1e293b; padding: 16px; border: none; border-radius: 10px; font-weight: 600; font-size: 15px; margin-top: 15px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; }
        
        .footer-text { margin-top: 30px; text-align: center; font-size: 12px; color: var(--text-gray); line-height: 1.6; }
        .footer-text a { color: #0047bb; text-decoration: none; }
        /* --- END OF LOGIN UPDATES --- */

        /* Original App UI Elements (Restored) */
        .btn-main { width: 100%; background: var(--primary-blue); color: white; padding: 16px; border: none; border-radius: 12px; font-weight: bold; cursor: pointer; }
        input, select { width: 100%; padding: 14px; border-radius: 12px; border: 1px solid #333; margin: 8px 0; box-sizing: border-box; background: #222; color: white; }
        .female-icon { width: 45px; height: 45px; border-radius: 50%; background: #333; display: flex; align-items: center; justify-content: center; font-size: 24px; border: 1px solid #444; }
        .error-msg { color: #ff4d4d; font-size: 13px; margin-top: 10px; display: none; font-weight: bold; }

        /* Dashboard */
        .balance-card { background: linear-gradient(135deg, #1e40af, #3b82f6); color: white; padding: 25px; border-radius: 24px; }
        .menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 25px 0; }
        .menu-item { aspect-ratio: 1/1; border-radius: 15px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; cursor: pointer; background: #262626; color: #cbd5e1; }

        /* Transactions */
        .txn-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; background: #222; border: 1px solid #333; border-radius: 8px; margin-bottom: 8px; cursor: pointer; min-height: 70px; }
        .txn-info { font-size: 11px; color: #94a3b8; line-height: 1.4; }

        /* Stats Graph */
        .graph-container { display: flex; align-items: flex-end; justify-content: space-between; height: 120px; padding: 10px; background: #222; border-radius: 12px; margin: 20px 0; border: 1px solid #333; }
        .graph-bar { width: 12%; background: var(--accent-blue); border-radius: 4px 4px 0 0; position: relative; transition: height 0.5s; }
        .graph-bar::after { content: attr(data-month); position: absolute; bottom: -20px; left: 0; width: 100%; text-align: center; font-size: 10px; color: #64748b; }

        /* Loading Spinner */
        #loader { display: none; text-align: center; padding: 50px; }
        .spinner { border: 4px solid rgba(255,255,255,0.1); border-top: 4px solid var(--accent-blue); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto 15px; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Receipt */
        .receipt-bold { border: 2px dashed #444; padding: 25px; border-radius: 4px; background: #fff; color: #000; margin-top: 10px; }
        .r-row { display: flex; justify-content: space-between; margin: 12px 0; border-bottom: 1px solid #eee; padding-bottom: 8px; font-size: 13px; }

        .bottom-nav { position: absolute; bottom: 0; width: 100%; height: 85px; background: #111; border-top: 1px solid #222; display: flex; justify-content: space-around; align-items: center; z-index: 10; }
        .nav-center { width: 50px; height: 50px; background: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: -45px; border: 5px solid #111; color: white; font-size: 24px; cursor: pointer; }
        .nav-item { text-align: center; font-size: 10px; color: #64748b; cursor: pointer; }
        
        .card-placeholder { width: 100%; height: 200px; background: #222; border: 2px dashed #444; border-radius: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; }
    </style>
</head>
<body>

<div class="phone-view">
    
    <!-- LOGIN SCREEN (Updated to image_10.png style) -->
    <div id="scr-login" class="screen active">
        <div class="login-container">
            <div class="logo-header">
                <b>e</b> ELITE SOLACE SAVINGS
            </div>

            <div class="login-card">
                <h2>Sign In to Elite Solace Savings</h2>
                <p>Access the Elite Solace Savings panel using your email and password.</p>
                
                <div class="input-group">
                    <label>Email Address</label>
                    <div class="input-wrapper">
                        <i>✉</i>
                        <input type="text" id="login-user" class="login-input" placeholder="name@email.com">
                    </div>
                </div>

                <div class="input-group">
                    <a href="#" class="forgot-link">Forgot Password?</a>
                    <label>Password</label>
                    <div class="input-wrapper">
                        <i>🔒</i>
                        <input type="password" id="login-pass" class="login-input" placeholder="••••••••">
                    </div>
                </div>

                <div class="checkbox-wrap">
                    <input type="checkbox" checked> Stay signed in for 30 days
                </div>

                <div id="login-error" class="error-msg" style="margin-bottom: 10px;">Verification failed.</div>

                <button class="btn-signin" onclick="validateLogin()">
                    ➜ Sign In
                </button>

                <button class="btn-enroll">
                    👤 Not enrolled? Create Account
                </button>
            </div>

            <div class="footer-text">
                By signing in, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
            </div>
        </div>
    </div>

    <!-- MAIN DASHBOARD (Restored - No Changes) -->
    <div id="scr-home" class="screen">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <div><small style="color:#94a3b8">Private Client</small><br><strong style="font-size:18px;">Emily Compagno</strong></div>
            <div class="female-icon">👩</div>
        </div>
        <div class="balance-card">
            <small style="opacity:0.8">Total Liquidity</small>
            <h1 id="main-bal" style="font-size:34px; margin:8px 0;">$1,500,000.00</h1>
            <div style="display:flex; justify-content:space-between; font-size:12px;"><span>01899187049</span><span>● PREMIUM</span></div>
        </div>
        <div class="menu-grid">
            <div class="menu-item" onclick="show('scr-home')">🏠<br>Home</div>
            <div class="menu-item" onclick="attemptWire()">📊<br>Wire</div>
            <div class="menu-item" onclick="show('scr-cards')">💳<br>Cards</div>
            <div class="menu-item" style="background:#422006; color:#fbbf24;" onclick="show('scr-form')">💸<br>Send</div>
            <div class="menu-item" onclick="show('scr-stats')">📈<br>Stats</div>
            <div class="menu-item" onclick="show('scr-profile')">👤<br>Profile</div>
        </div>
        <h3>Recent Activity</h3>
        <div id="txn-container">
            <div class="txn-row" onclick="slowShowReceipt('Douglas Grace', 25000, 'Chime', 'May 06, 2026, 14:02:55', 'ESL-3819081', 'SUCCESSFUL')">
                <div class="txn-info">
                    <strong style="color:white; font-size:13px;">Chime Transfer</strong><br>
                    To: Douglas Grace<br>
                    ID: ESL-3819081<br>
                    <span style="font-size:9px;">May 06, 2026</span>
                </div>
                <div style="text-align:right">
                    <span style="color:#ff4d4d; font-weight:bold; font-size:14px;">-$25,000.00</span><br>
                    <span style="color:var(--success-green); font-size:9px; font-weight:bold;">SUCCESSFUL</span>
                </div>
            </div>
            <div class="txn-row" onclick="slowShowReceipt('Michael Terry', 50000, 'Zelle', 'May 06, 2026, 09:14:22', 'REF-9928310', 'SUCCESSFUL')">
                <div class="txn-info">
                    <strong style="color:white; font-size:13px;">Zelle Transfer</strong><br>
                    To: Micheal Terry<br>
                    ID: REF-9928310<br>
                    <span style="font-size:9px;">May 06, 2026</span>
                </div>
                <div style="text-align:right">
                    <span style="color:#ff4d4d; font-weight:bold; font-size:14px;">-$50,000.00</span><br>
                    <span style="color:var(--success-green); font-size:9px; font-weight:bold;">SUCCESSFUL</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ALL OTHER SCREENS (Restored - No Changes) -->
    <div id="scr-stats" class="screen">
        <button onclick="show('scr-home')" style="border:none; background:none; color:white; margin-bottom:10px;">← Dashboard</button>
        <h2>Financial Stats</h2>
        <div class="graph-container">
            <div class="graph-bar" style="height: 40%;" data-month="Jan"></div>
            <div class="graph-bar" style="height: 55%;" data-month="Feb"></div>
            <div class="graph-bar" style="height: 45%;" data-month="Mar"></div>
            <div class="graph-bar" style="height: 80%;" data-month="Apr"></div>
            <div class="graph-bar" style="height: 60%; background: #fff;" data-month="May"></div>
            <div class="graph-bar" style="height: 20%; opacity: 0.3;" data-month="Jun"></div>
        </div>
        <div style="margin-top:25px; background:#222; border-radius:12px; padding:20px; border: 1px solid #333;">
            <div style="display:flex; justify-content:space-between; margin-bottom:12px;"><span>Total Account Income</span><strong>$1,738,000.00</strong></div>
            <div style="display:flex; justify-content:space-between; margin-bottom:12px;"><span>Total Withdrawn</span><strong>$238,000.00</strong></div>
            <div style="display:flex; justify-content:space-between; color:var(--accent-blue); padding-top:10px; border-top:1px solid #444;"><span>Net Balance</span><strong>$1,500,000.00</strong></div>
        </div>
    </div>

    <div id="scr-cards" class="screen">
        <button onclick="show('scr-home')" style="border:none; background:none; color:white; margin-bottom:20px;">← Back</button>
        <h2>My Cards</h2>
        <div class="card-placeholder" onclick="requestCard()">
            <div style="font-size:40px; margin-bottom:10px;">💳</div>
            <p style="margin:0; font-weight:bold; color:#64748b;">Tap to Request Card</p>
        </div>
    </div>

    <div id="scr-pin" class="screen">
        <div style="text-align:center; padding-top:80px;">
            <div style="font-size: 40px; margin-bottom: 15px;">🔒</div>
            <h2>Transaction PIN</h2>
            <input type="password" id="pin-input" maxlength="4" placeholder="••••" style="text-align:center; font-size:24px; letter-spacing:10px;">
            <div id="pin-error" class="error-msg">Incorrect PIN. Access Denied.</div>
            <button class="btn-main" style="margin-top:20px;" onclick="verifyPin()">AUTHORIZE</button>
            <button style="background:none; border:none; color:#64748b; margin-top:20px; cursor:pointer;" onclick="show('scr-form')">Cancel</button>
        </div>
    </div>

    <div id="scr-loading" class="screen">
        <div id="loader" style="display:block; margin-top:100px;">
            <div class="spinner"></div>
            <p id="loading-text">Processing...</p>
        </div>
    </div>

    <div id="scr-form" class="screen">
        <button onclick="show('scr-home')" style="border:none; background:none; color:white;">← Back</button>
        <h2>Authorized Transfer</h2>
        <select id="p-method">
            <option>Cash App</option>
            <option>Chime</option>
            <option>Zelle</option>
            <option>PayPal</option>
            <option>Venmo</option>
        </select>
        <input type="text" id="p-to" placeholder="Account Identifier">
        <input type="number" id="p-amt" placeholder="Amount">
        <button class="btn-main" onclick="goToPin()">EXECUTE TRANSFER</button>
    </div>

    <div id="scr-receipt" class="screen">
        <button onclick="show('scr-home')" style="border:none; background:none; color:white; margin-bottom:20px;">← Close</button>
        <div id="r-status-box" style="padding:12px; text-align:center; font-weight:bold; border-radius:8px;"></div>
        <div class="receipt-bold">
            <div style="text-align:center; border-bottom:2px solid #000; padding-bottom:15px; margin-bottom:15px;">
                <h3 style="margin:0">OFFICIAL RECORD</h3>
                <small id="r-time" style="color:#666"></small>
            </div>
            <div class="r-row"><span>Platform</span><strong id="r-plat"></strong></div>
            <div class="r-row"><span>Recipient</span><strong id="r-target"></strong></div>
            <div style="text-align:center; margin:30px 0;">
                <small>AUTH AMOUNT</small>
                <h1 style="margin:5px 0; font-size:36px;">$<span id="r-val"></span></h1>
            </div>
            <div class="r-row" style="border:none;"><span style="font-size:10px;">ID: <span id="r-id"></span></span></div>
        </div>
    </div>

    <div id="scr-profile" class="screen">
        <button onclick="show('scr-home')" style="border:none; background:none; color:white;">← Dashboard</button>
        <div style="text-align:center; margin-top:30px;">
            <div class="female-icon" style="width:80px; height:80px; margin:0 auto; font-size:40px;">👩</div>
            <h2>Emily Compagno</h2>
            <button class="btn-main" style="margin-top:40px; background:#991b1b;" onclick="location.reload()">TERMINATE SESSION</button>
        </div>
    </div>

    <div class="bottom-nav">
        <div class="nav-item" onclick="show('scr-home')">🏠<br>Home</div>
        <div class="nav-item" onclick="show('scr-stats')">📊<br>Stats</div>
        <div class="nav-center" onclick="show('scr-home')">▦</div>
        <div class="nav-item" onclick="show('scr-cards')">💳<br>Cards</div>
        <div class="nav-item" onclick="show('scr-profile')">👤<br>Profile</div>
    </div>
</div>

<script>
    let balance = parseFloat(localStorage.getItem('balance')) || 1500000.00;
    let savedTxns = JSON.parse(localStorage.getItem('transactions')) || [];

    window.onload = function() {
        updateBalanceDisplay();
        loadSavedTransactions();
    };

    function updateBalanceDisplay() {
        document.getElementById('main-bal').innerText = "$" + balance.toLocaleString(undefined, {minimumFractionDigits:2});
    }

    function loadSavedTransactions() {
        const container = document.getElementById('txn-container');
        savedTxns.forEach(t => {
            const html = createTxnHtml(t.target, t.amt, t.plat, t.time, t.id, t.status);
            container.insertAdjacentHTML('afterbegin', html);
        });
    }

    function createTxnHtml(target, amt, plat, time, id, status) {
        let statusColor = status === "SUCCESSFUL" ? "var(--success-green)" : "var(--pending-orange)";
        return `
            <div class="txn-row" onclick="slowShowReceipt('${target}', ${amt}, '${plat}', '${time}', '${id}', '${status}')">
                <div class="txn-info">
                    <strong style="color:white; font-size:13px;">${plat} Transfer</strong><br>
                    To: ${target.substring(0,15)}...<br>
                    ID: ${id}<br>
                    <span style="font-size:9px;">${time.split(',')[0]}</span>
                </div>
                <div style="text-align:right">
                    <span style="color:#ff4d4d; font-weight:bold; font-size:14px;">-$${amt.toLocaleString()}</span><br>
                    <span style="color:${statusColor}; font-size:9px; font-weight:bold;">${status}</span>
                </div>
            </div>`;
    }

    function validateLogin() {
        const u = document.getElementById('login-user').value;
        const p = document.getElementById('login-pass').value;
        if((u === "Emily9090" || u === "name@email.com") && (p === "Emily9090!" || p === "9090")) {
            show('scr-home');
        } else {
            document.getElementById('login-error').style.display = 'block';
        }
    }

    function show(id) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(id).classList.add('active');
    }

    function attemptWire() {
        document.getElementById('loading-text').innerText = "Connecting to Global Wire Exchange...";
        show('scr-loading');
        setTimeout(() => {
            show('scr-home');
            alert('Wire Access: Your account cannot make international transfers happen right now.');
        }, 2000);
    }

    function requestCard() {
        document.getElementById('loading-text').innerText = "Verifying Card Eligibility...";
        show('scr-loading');
        setTimeout(() => {
            show('scr-cards');
            alert('Request Received: An advisor will contact you regarding card issuance.');
        }, 2500);
    }

    function slowShowReceipt(target, val, plat, time, id, status) {
        document.getElementById('loading-text').innerText = "Fetching Secure Record...";
        show('scr-loading');
        setTimeout(() => {
            document.getElementById('r-target').innerText = target;
            document.getElementById('r-val').innerText = parseFloat(val).toLocaleString();
            document.getElementById('r-plat').innerText = plat;
            document.getElementById('r-time').innerText = time;
            document.getElementById('r-id').innerText = id;
            const sBox = document.getElementById('r-status-box');
            sBox.innerText = status;
            sBox.style.background = status === "SUCCESSFUL" ? "#064e3b" : "#451a03";
            sBox.style.color = status === "SUCCESSFUL" ? "#34d399" : "#fbbf24";
            show('scr-receipt');
        }, 1500);
    }

    function goToPin() {
        const amt = document.getElementById('p-amt').value;
        if(!amt || amt <= 0) { alert("Please enter a valid amount."); return; }
        document.getElementById('pin-input').value = "";
        document.getElementById('pin-error').style.display = "none";
        show('scr-pin');
    }

    function verifyPin() {
        const pin = document.getElementById('pin-input').value;
        if(pin === "9090") {
            startTransfer();
        } else {
            document.getElementById('pin-error').style.display = "block";
        }
    }

    function startTransfer() {
        document.getElementById('loading-text').innerText = "Processing Secure Transfer...";
        show('scr-loading');
        
        setTimeout(() => {
            const amt = parseFloat(document.getElementById('p-amt').value);
            const plat = document.getElementById('p-method').value;
            const target = document.getElementById('p-to').value || "External Account";
            const txnId = "ESL-" + Math.floor(Math.random()*9000000 + 1000000);
            const time = new Date().toLocaleString();
            
            balance -= amt;
            localStorage.setItem('balance', balance);
            updateBalanceDisplay();
            
            const newTxn = { target, amt, plat, time, id: txnId, status: 'PENDING' };
            savedTxns.push(newTxn);
            localStorage.setItem('transactions', JSON.stringify(savedTxns));
            
            const txnHtml = createTxnHtml(target, amt, plat, time, txnId, 'PENDING');
            document.getElementById('txn-container').insertAdjacentHTML('afterbegin', txnHtml);
            
            slowShowReceipt(target, amt, plat, time, txnId, 'PENDING');
        }, 4000);
    }
</script>
</body>
</html>
